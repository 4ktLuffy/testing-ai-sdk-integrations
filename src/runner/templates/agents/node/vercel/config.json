{
  "name": "vercel",
  "platform": "node",
  "streamingMode": "both",
  "dependencies": [
    {
      "package": "ai",
      "version": "framework"
    },
    {
      "package": "@ai-sdk/openai",
      "version": "4.0.47"
    },
    {
      "package": "@ai-sdk/anthropic",
      "version": "4.0.42"
    }
  ],
  "versions": ["7"],
  "sentryVersions": ["11"],
  "options": {
    "agentStyle": ["function", "class"],
    "provider": [
      {
        "value": "openai",
        "overrides": {
          "modelOverrides": {
            "request": "openai/gpt-4o-mini",
            "response": "openai/gpt-4o-mini*"
          }
        }
      },
      {
        "value": "anthropic",
        "overrides": {
          "modelOverrides": {
            "request": "anthropic/claude-haiku-4-5",
            "response": "anthropic/claude-haiku-4.5*"
          }
        }
      }
    ]
  }
}
