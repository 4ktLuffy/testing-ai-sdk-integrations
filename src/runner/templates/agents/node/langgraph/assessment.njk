{% extends "base.node.assessment.njk" %}

{% block dynamic_imports %}
{% if provider == "anthropic" %}
const { ChatAnthropic } = await import("@langchain/anthropic");
{% else %}
const { ChatOpenAI } = await import("@langchain/openai");
{% endif %}
const { createReactAgent } = await import("@langchain/langgraph/prebuilt");
const { AIMessage, HumanMessage, SystemMessage } = await import("@langchain/core/messages");
const { tool } = await import("@langchain/core/tools");
const { z } = await import("zod");
{% endblock %}

{% block fault_call %}
{% if provider != "anthropic" %}
const { GraphRecursionError } = await import("@langchain/langgraph");
// createReactAgent answers with this message instead of raising when the
// remaining steps cannot fit another tool round.
const REMAINING_STEPS_MESSAGE = "Sorry, need more steps to process this request.";

runFaultCall = async (probe, request) => {
  const fault = probe.input.fault;
  const toolLog = [];
  const faultTools = (probe.input.tools ?? []).map((definition) => tool(
    faultToolHandler(definition, toolLog),
    { name: definition.name, description: definition.description, schema: definition.parameters },
  ));
  const llm = new ChatOpenAI({
    model: request.model,
    apiKey: process.env.OPENROUTER_API_KEY,
    configuration: { baseURL: {% if providerTruth %}process.env.SENTRY_ASSESSMENT_OPENROUTER_BASE || {% endif %}"https://openrouter.ai/api/v1" },
    maxRetries: fault.maxRetries ?? 2,
    ...(fault.maxOutputTokens ? { maxTokens: fault.maxOutputTokens } : {}),
  });
  const agent = createReactAgent({ llm, tools: faultTools, name: "assessment-agent" });
  let state;
  try {
    // Each model call is one agent step plus one tool step.
    state = await agent.invoke(
      { messages: [new HumanMessage(request.messages.at(-1).content)] },
      { recursionLimit: 2 * fault.maxModelCalls },
    );
  } catch (error) {
    emitAgentLog(probe, request, toolLog, { error, stepLimit: error instanceof GraphRecursionError || error?.name === "GraphRecursionError" });
    return;
  }
  const content = state.messages.at(-1)?.content;
  const answer = typeof content === "string" ? content : JSON.stringify(content);
  emitAgentLog(probe, request, toolLog, { answer, stepLimit: answer === REMAINING_STEPS_MESSAGE });
};
{% endif %}
{% endblock %}

{% block probe %}
          const tools = (probe.input.tools ?? []).map((definition) => tool(
            async () => {
              if (definition.error) throw new Error(definition.error);
              return definition.result;
            },
            { name: definition.name, description: definition.description, schema: z.object({}).passthrough() },
          ));
          for (const request of probe.input.calls) {
            await runAssessmentCall(probe, request, async () => {
            if (request.conversationId && typeof Sentry.setConversationId === "function") Sentry.setConversationId(request.conversationId);
            const messages = request.messages.map((message) => message.role === "system" ? new SystemMessage(message.content) : message.role === "assistant" ? new AIMessage(message.content) : new HumanMessage(message.content));
{% if provider == "anthropic" %}
            const llm = new ChatAnthropic({ modelName: request.model, anthropicApiKey: process.env.OPENROUTER_API_KEY, anthropicApiUrl: "https://openrouter.ai/api", thinking: { type: "enabled", budget_tokens: 1024 } });
{% else %}
            const llm = new ChatOpenAI({ modelName: request.model, apiKey: process.env.OPENROUTER_API_KEY, configuration: { baseURL: {% if providerTruth %}process.env.SENTRY_ASSESSMENT_OPENROUTER_BASE || {% endif %}"https://openrouter.ai/api/v1" } });
{% endif %}
            try {
              const agent = createReactAgent({ llm, tools, name: "assessment-agent" });
              await agent.invoke({ messages });
            } catch (error) {
              if (probe.input.expectError) { Sentry.captureException(error); return; }
              throw error;
            }
            });
          }
{% endblock %}
