def emit_agent_log(probe, request, tool_log, answer=None, error=None, step_limit=False):
    event = {
        "type": "agent_log",
        "probeId": probe["id"],
        "callId": request["assessmentCallId"],
        "tools": tool_log,
        "sendDefaultPii": SEND_DEFAULT_PII,
    }
    if isinstance(answer, str):
        event["answer"] = answer
    if error is not None or step_limit:
        event["error"] = {
            "type": type(error).__name__ if error is not None else "StepLimit",
            "message": str(error)[:500] if error is not None else "",
            "stepLimit": step_limit,
        }
    emit(event)


def fault_tool_handler(definition, tool_log):
    # Log the call, then return the probe's fixed result as a successful value.
    def handle(arguments):
        tool_log.append({"name": definition["name"], "arguments": json.dumps(arguments, sort_keys=True)})
        result = definition.get("result")
        return result if isinstance(result, str) else json.dumps(result)

    return handle


