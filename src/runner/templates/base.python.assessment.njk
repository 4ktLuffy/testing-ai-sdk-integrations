def mark_provider_call(call_id, phase):
    # Provider-truth call markers: exchanges recorded between start and end
    # belong to this call. A raw socket keeps the marker invisible to the SDK's
    # HTTP instrumentation, so markers never create spans.
    url = os.environ.get("SENTRY_ASSESSMENT_PROVIDER_TRUTH_URL")
    if not url:
        return
    target = urllib.parse.urlsplit(url)
    query = urllib.parse.urlencode({"id": call_id, "phase": phase})
    request = (
        f"POST {target.path}/_call?{query} HTTP/1.1\r\n"
        f"Host: {target.netloc}\r\nContent-Length: 0\r\nConnection: close\r\n\r\n"
    ).encode()
    try:
        with socket.create_connection((target.hostname, target.port), timeout=5) as connection:
            connection.sendall(request)
            while connection.recv(4096):
                pass
    except Exception as error:
        print(f"Provider-truth call marker failed: {error}", flush=True)
{% endif %}


@contextmanager
def assessment_call(probe, request):
    call_id = request.get("assessmentCallId")
    call_mode = request.get("assessmentCallMode")
    if not isinstance(call_id, str) or not isinstance(call_mode, str):
        raise RuntimeError(f"Assessment call metadata is missing for {probe['id']}.")
    with sentry_sdk.start_span(op="test.assessment.call", name=call_id) as span:
        span.set_data("test.probe.id", probe["id"])
        span.set_data("test.call.id", call_id)
        span.set_data("test.call.mode", call_mode)
{% if providerTruth %}
        mark_provider_call(call_id, "start")
        try:
            yield
        finally:
            mark_provider_call(call_id, "end")
{% else %}
        yield
{% endif %}


def flush_sentry(probe_id=None):
    failure = None

    def record_timeout(pending, timeout):
        nonlocal failure
        failure = {
            "kind": "flush",
            "message": f"Sentry flush timed out with {pending} pending event(s) after {timeout} seconds.",
            "stopsVariant": True,
        }

    try:
        sentry_sdk.flush(timeout=5, callback=record_timeout)
    except Exception as error:
        failure = {
            "kind": "flush",
            "message": str(error),
            "stopsVariant": True,
        }

    if failure is None:
        return True
    if probe_id:
        failure["probeId"] = probe_id
    emit({"type": "runtime_failure", "failure": failure})
    return False


async def run_assessment():
    blocked = False
    for probe in PROBES:
        if blocked:
            emit({"type": "probe_blocked", "probeId": probe["id"]})
            continue

        emit({"type": "probe_started", "probeId": probe["id"]})
        try:
            with sentry_sdk.start_transaction(op="test.assessment", name=probe["id"]) as span:
                span.set_data("test.assessment.id", "{{ targetId }}")
                span.set_data("test.variant.id", "{{ variantId }}")
                span.set_data("test.probe.id", probe["id"])
{% block probe %}
                raise RuntimeError("Assessment adapter does not implement this probe")
{% endblock %}
            emit({"type": "probe_finished", "probeId": probe["id"], "status": "completed"})
        except Exception as error:
            failure = {
                "kind": "provider",
                "message": str(error),
                "probeId": probe["id"],
                "stopsVariant": probe["stopsVariantOnFailure"],
            }
            emit({"type": "probe_failed", "probeId": probe["id"], "status": "failed", "failure": failure})
            if failure["stopsVariant"]:
                blocked = True
        finally:
            if not flush_sentry(probe["id"]):
                blocked = True

    emit({"type": "assessment_finished"})
    flush_sentry()


try:
    asyncio.run(run_assessment())
except Exception as error:
    emit({"type": "assessment_finished"})
    print(error)
    raise
