// Generated Sentry AI assessment program. Do not edit.
import * as Sentry from "@sentry/node";

const EVENT_PREFIX = "@@SENTRY_ASSESSMENT@@ ";
const emit = (event) => console.log(`${EVENT_PREFIX}${JSON.stringify(event)}`);

Sentry.init({
  dsn: process.env.SENTRY_DSN,
  sendDefaultPii: {% if detectability %}process.env.SENTRY_ASSESSMENT_SEND_DEFAULT_PII !== "0"{% else %}true{% endif %},
  tracesSampleRate: 1.0,
  streamGenAiSpans: true,
{% if detectability %}
  // SENTRY_ASSESSMENT_GENAI_DATA_COLLECTION=0 turns off AI inputs/outputs. In
  // @sentry/node 11 this, not sendDefaultPii, gates prompts, answers and tool I/O.
  ...(process.env.SENTRY_ASSESSMENT_GENAI_DATA_COLLECTION === "0"
    ? { dataCollection: { genAI: { inputs: false, outputs: false } } }
    : {}),
{% endif %}
});

{% block dynamic_imports %}{% endblock %}

const probes = {{ probes | tojson }};

async function runAssessmentCall(probe, request, callback) {
  if (typeof request.assessmentCallId !== "string" || typeof request.assessmentCallMode !== "string") {
    throw new Error(`Assessment call metadata is missing for ${probe.id}.`);
  }
  return Sentry.startSpan(
    {
      name: request.assessmentCallId,
      op: "test.assessment.call",
      attributes: {
        "test.probe.id": probe.id,
        "test.call.id": request.assessmentCallId,
        "test.call.mode": request.assessmentCallMode,
      },
    },
{% if providerTruth %}
    async (span) => {
      await markProviderCall(request.assessmentCallId, "start"{% if detectability %}, probe.input.fault?.providerFault{% endif %});
      try {
        return await callback(span);
      } finally {
        await markProviderCall(request.assessmentCallId, "end");
      }
    },
{% else %}
    callback,
{% endif %}
  );
}
{% if providerTruth %}

// Provider-truth call markers: exchanges recorded between start and end belong
// to this call. Tracing is suppressed so markers never create spans.
async function markProviderCall(callId, phase{% if detectability %}, fault{% endif %}) {
  const url = process.env.SENTRY_ASSESSMENT_PROVIDER_TRUTH_URL;
  if (!url) return;
{% if detectability %}
  const query = new URLSearchParams({ id: callId, phase, ...(fault ? { fault } : {}) });
{% else %}
  const query = new URLSearchParams({ id: callId, phase });
{% endif %}
  try {
    await Sentry.suppressTracing(() =>
      fetch(`${url}/_call?${query}`, { method: "POST" }).then((response) => response.text()),
    );
  } catch (error) {
    console.error(`Provider-truth call marker failed: ${error instanceof Error ? error.message : String(error)}`);
  }
}
{% endif %}
{% if detectability %}

// Failure injection (--detectability). The program's own log is the ground
// truth: which tools ran with which arguments, the answer, and how the run ended.
const FAULT_PROBE_PREFIX = "agent.fault.";
const SEND_DEFAULT_PII = process.env.SENTRY_ASSESSMENT_SEND_DEFAULT_PII !== "0";
const GENAI_DATA_COLLECTION = process.env.SENTRY_ASSESSMENT_GENAI_DATA_COLLECTION !== "0";

function stableJson(value) {
  if (Array.isArray(value)) return `[${value.map(stableJson).join(",")}]`;
  if (value && typeof value === "object") {
    return `{${Object.keys(value).sort().map((key) => `${JSON.stringify(key)}:${stableJson(value[key])}`).join(",")}}`;
  }
  return JSON.stringify(value) ?? "null";
}

function emitAgentLog(probe, request, toolLog, { answer, error, stepLimit = false } = {}) {
  const event = {
    type: "agent_log",
    probeId: probe.id,
    callId: request.assessmentCallId,
    tools: toolLog,
    sendDefaultPii: SEND_DEFAULT_PII,
    genAIDataCollection: GENAI_DATA_COLLECTION,
    timestamp: new Date().toISOString(),
  };
  if (typeof answer === "string") event.answer = answer;
  if (error !== undefined || stepLimit) {
    event.error = {
      type: error === undefined ? "StepLimit" : (error?.constructor?.name ?? "Error"),
      message: error === undefined ? "" : String(error instanceof Error ? error.message : error).slice(0, 500),
      stepLimit,
    };
  }
  emit(event);
}

// Log the call, then return the probe's fixed result as a successful value.
function faultToolHandler(definition, toolLog) {
  return async (args) => {
    toolLog.push({ name: definition.name, arguments: stableJson(args ?? {}) });
    return typeof definition.result === "string" ? definition.result : JSON.stringify(definition.result);
  };
}

let runFaultCall;
{% block fault_call %}{% endblock %}
{% endif %}

async function flushSentry(probeId) {
  let message;
  try {
    if (await Sentry.flush(5000)) return true;
    message = "Sentry flush timed out before all telemetry was sent.";
  } catch (error) {
    message = error instanceof Error ? error.message : String(error);
  }
  const failure = { kind: "flush", message, stopsVariant: true };
  if (probeId) failure.probeId = probeId;
  emit({ type: "runtime_failure", failure, timestamp: new Date().toISOString() });
  return false;
}

async function runAssessment() {
  let blocked = false;

  for (const probe of probes) {
    if (blocked) {
      emit({ type: "probe_blocked", probeId: probe.id });
      continue;
    }

    emit({ type: "probe_started", probeId: probe.id, timestamp: new Date().toISOString() });
    try {
      await Sentry.startSpan(
        {
          name: probe.id,
          op: "test.assessment",
          attributes: {
            "test.assessment.id": "{{ targetId }}",
            "test.variant.id": "{{ variantId }}",
            "test.probe.id": probe.id,
          },
        },
        async () => {
{% if detectability %}
          if (probe.id.startsWith(FAULT_PROBE_PREFIX)) {
            if (!runFaultCall) throw new Error("This adapter does not implement failure injection.");
            for (const request of probe.input.calls) {
              await runAssessmentCall(probe, request, () => runFaultCall(probe, request));
            }
            return;
          }
{% endif %}
{% block probe %}
          throw new Error("Assessment adapter does not implement this probe.");
{% endblock %}
        },
      );
      emit({ type: "probe_finished", probeId: probe.id, status: "completed", timestamp: new Date().toISOString() });
    } catch (error) {
      const message = error instanceof Error ? error.message : String(error);
      const failure = {
        kind: "provider",
        message,
        probeId: probe.id,
        stopsVariant: Boolean(probe.stopsVariantOnFailure),
      };
      emit({ type: "probe_failed", probeId: probe.id, status: "failed", failure, timestamp: new Date().toISOString() });
      if (failure.stopsVariant) blocked = true;
    } finally {
      if (!(await flushSentry(probe.id))) blocked = true;
    }
  }

  emit({ type: "assessment_finished", timestamp: new Date().toISOString() });
  await flushSentry();
}

runAssessment().catch((error) => {
  emit({ type: "assessment_finished", timestamp: new Date().toISOString() });
  console.error(error);
  process.exitCode = 1;
});
